# ==============================================================================
# LexisGraph Backend Environment Configuration Template
# Copy this file to .env and set your own values.
# Never commit .env with real credentials.
# ==============================================================================

# Application Environment
APP_ENV=production
# CORS: Set to your frontend deployment URL once known (e.g. https://your-app.vercel.app)
# For initial testing across origins, you can temporarily set: CORS_ALLOW_ORIGINS=*
# CORS_ALLOW_ORIGINS=https://your-app.vercel.app

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Docker container service "postgres" on port 5432)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lexisgraph
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=lexisgraph
# Optional connection string used by Alembic & SQLAlchemy session:
DATABASE_URL=postgresql+psycopg2://lexisgraph:CHANGE_ME_postgres_password@postgres:5432/lexisgraph

# ------------------------------------------------------------------------------
# Neo4j Graph Database (Docker container service "neo4j" on Bolt port 7687)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# Qdrant Vector Store (Docker container service "qdrant" on port 6333)
# Note: App connects without API key auth inside the private Docker network.
# ------------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ------------------------------------------------------------------------------
# Redis Cache & Session Store (Docker container service "redis" on port 6379)
# Note: App connects without password auth inside the private Docker network.
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# Note: The backend exclusively reads JWT_SECRET (SECRET_KEY is unused).
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_strong_random_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# External APIs & LLM Reasoning (Optional)
# ------------------------------------------------------------------------------
NEWSAPI_KEY=
LLM_REASONING_PROVIDER=auto
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free
OPENROUTER_TIMEOUT_SECONDS=12

# ------------------------------------------------------------------------------
# Graph Tuning Parameters
# ------------------------------------------------------------------------------
GRAPH_SIMILARITY_THRESHOLD=0.75
GRAPH_SIMILARITY_TOP_K=3
GRAPH_SIMILARITY_MAX_CLAUSES=120