# Copy this file to .env and set your own values.
# Never commit .env with real credentials.
#
# Use KEY=value with no spaces around = and no quotes on values.

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<optional-db>?retryWrites=true&w=majority
MONGO_DB_NAME=lexisgraph

NEO4J_URI=neo4j+s://<your-aura-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<neo4j-password>
NEO4J_DATABASE=neo4j

NEWSAPI_KEY=

APP_ENV=development
# Optional: comma-separated origins for production or custom environments
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional graph tuning
# GRAPH_SIMILARITY_MAX_CLAUSES=120
# GRAPH_SIMILARITY_THRESHOLD=0.75
# GRAPH_SIMILARITY_TOP_K=3

# Optional OpenRouter-based reasoning
LLM_REASONING_PROVIDER=auto
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free
OPENROUTER_TIMEOUT_SECONDS=12