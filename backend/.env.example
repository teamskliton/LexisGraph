# ==============================================================================
# LexisGraph Backend Environment Configuration Template
# Copy this file to .env and set your own values.
# Never commit .env with real credentials.
# ==============================================================================

# Application Environment
APP_ENV=development
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Docker container maps host 5433 -> container 5432)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=lexisgraph

# ------------------------------------------------------------------------------
# Neo4j Graph Database (Docker container on port 7687 or Neo4j Aura)
# ------------------------------------------------------------------------------
# Local Docker: bolt://localhost:7687
# Aura Cloud:  neo4j+s://<your-aura-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# Qdrant Vector Store (Docker container on port 6333)
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ------------------------------------------------------------------------------
# Redis Cache & Session Store (Docker container on port 6379)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# MongoDB Configuration (Local or Atlas)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=lexisgraph

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# External APIs & LLM Reasoning (Optional)
# ------------------------------------------------------------------------------
NEWSAPI_KEY=
LLM_REASONING_PROVIDER=auto
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free
OPENROUTER_TIMEOUT_SECONDS=12

# ------------------------------------------------------------------------------
# Graph Tuning Parameters
# ------------------------------------------------------------------------------
GRAPH_SIMILARITY_THRESHOLD=0.75
GRAPH_SIMILARITY_TOP_K=3
GRAPH_SIMILARITY_MAX_CLAUSES=120