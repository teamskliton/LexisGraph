# =============================================================================
# LexisGraph — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in real values before running docker compose.
# The .env file is excluded from git (.gitignore). NEVER commit real secrets.
#
# On the VPS:
#   cp .env.example .env
#   nano .env          # fill in all values
#   chmod 600 .env     # restrict permissions so only your user can read it
# =============================================================================


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# The database that stores all relational data for LexisGraph.
# Use a long random password (e.g. `openssl rand -hex 32`).

POSTGRES_USER=lexisgraph
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=lexisgraph


# ── pgAdmin ───────────────────────────────────────────────────────────────────
# Web UI for managing Postgres. Only reachable via SSH tunnel (not public).
# Set a real email address you own and a strong password.

PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_strong_random_password


# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Graph database. NEO4J_USER must be "neo4j" (required by Neo4j 5).
# Only the password is customisable.

NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_strong_random_password


# ── Redis ─────────────────────────────────────────────────────────────────────
# In-memory cache / task queue. requirepass is enforced by docker-compose.yml.

REDIS_PASSWORD=CHANGE_ME_strong_random_password


# ── Qdrant ────────────────────────────────────────────────────────────────────
# Vector database. API key is enforced even on the internal Docker network.
# Your FastAPI backend must pass this key in the `api-key` header.

QDRANT_API_KEY=CHANGE_ME_strong_random_api_key


# ── FastAPI Backend ───────────────────────────────────────────────────────────
# Internal connection strings — these use Docker service names as hostnames,
# not localhost. The backend container resolves them over the `lexis_net` network.

# PostgreSQL (SQLAlchemy / asyncpg format)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Neo4j Bolt
NEO4J_URI=bolt://neo4j:7687

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333

# Django/FastAPI secret key — used for JWT signing, session cookies, etc.
SECRET_KEY=CHANGE_ME_strong_random_secret_key

# Set to "production" on the VPS
ENVIRONMENT=production


# ── Caddy / Reverse Proxy (for when you wire up HTTPS) ───────────────────────
# Uncomment and fill in when you enable the Caddy service in docker-compose.yml.

# DOMAIN=api.yourdomain.com
