# ==========================================
# LexisGraph .gitignore
# ==========================================

# Environments & Secret Files
.env
.env.*
*.env
!.env.example
backend/.env
client/.env*.local

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/
backend/.venv/

# Testing & Code Quality
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
coverage/

# Node.js & Frontend Client
node_modules/
client/node_modules/
.npm/
.eslintcache
.next/
client/.next/
out/
client/out/
client/next-env.d.ts

# Local Storage & Uploads (keep directory placeholders)
backend/storage/uploads/regulations/*
backend/storage/uploads/policies/*
backend/storage/uploads/evidence/*
!backend/storage/uploads/regulations/.gitkeep
!backend/storage/uploads/policies/.gitkeep
!backend/storage/uploads/evidence/.gitkeep

# Data & Ingestion Artifacts
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/data/domain_documents/*/processed/*.json
backend/data/domain_documents/*/raw/*
!backend/data/domain_documents/*/raw/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
external data/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# AI Agent & Assistant Artifacts
.agents/
.claude/
brain/